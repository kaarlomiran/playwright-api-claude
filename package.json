{
  "name": "playwright-api-claude",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright (TypeScript) API test suite for https://dummyjson.com, run by Jenkins on every merge to main.",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:flaky-probe": "playwright test --repeat-each=10 --retries=0 --workers=1",
    "flaky": "tsx .claude/skills/flaky-monitor/scripts/analyze-flaky.ts",
    "report": "playwright show-report reports/html"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.25",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
